# Default deny: explicitly allow only the publishable Skill bundle.
/*
!/.gitignore
!/README.md
!/SKILL.md
!/AGENTS.md
!/WORKFLOW.md
!/WORKFLOW_SCHEMA.md
!/LICENSE
!/agents/
!/assets/
!/scripts/
!/references/
!/.github/
/agents/*
!/agents/openai.yaml
/assets/*
!/assets/analyze.svg
!/assets/analyze.png
/scripts/*
!/scripts/*.py
/references/*
!/references/*.md
!/references/playbooks/
!/references/specialists/
!/references/finance/
!/references/knowledge/
!/references/cases/
!/references/video/
/references/video/*
!/references/video/caption-workflow.md
!/references/video/fetch_captions.py
**/__pycache__/
**/*.pyc
**/.env
**/.env.*
**/*.pem
**/*.key
**/*.log
**/transcript.txt
**/captions/
**/selected_transcript.md
**/*.vtt
**/*.srt
**/*.mp3
**/*.m4a
**/*.mp4
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/test.yml
